# Port the HTTP + WebSocket server listens on
PORT=3001

# Required. Encrypts saved SSH passwords/private keys at rest (AES-256-GCM).
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit this value to Git. Losing/changing it makes previously saved
# credentials undecryptable.
ENCRYPTION_KEY=

# Set to "true" once this app is served over HTTPS (directly or behind a
# reverse proxy) so the auth cookie is marked Secure. Leave unset/"false"
# for local http://localhost development.
COOKIE_SECURE=false
